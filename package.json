{
  "name": "agent-durbar",
  "version": "0.1.0-alpha.3",
  "description": "Command center to see, chat with and coordinate coding agents (Copilot CLI first) in an office-style view.",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "Three Feathers",
    "url": "https://github.com/three-feathers"
  },
  "contributors": [
    {
      "name": "vikramgorla",
      "url": "https://github.com/vikramgorla"
    },
    {
      "name": "fjcabello",
      "url": "https://github.com/fjcabello"
    },
    {
      "name": "rubenlupi",
      "url": "https://github.com/rubenlupi"
    }
  ],
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.js",
    "smoke": "tsc -p tsconfig.scripts.json && node dist-scripts/scripts/smoke.js",
    "verify:cap": "tsc -p tsconfig.scripts.json && node dist-scripts/scripts/verify-cap.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "npm run build && electron .",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test:permissions": "tsc -p tsconfig.scripts.json && node dist-scripts/scripts/test-permissions.js",
    "test:attachments": "tsc -p tsconfig.scripts.json && node dist-scripts/scripts/test-attachments.js",
    "test": "npm run test:permissions && npm run test:attachments && npm run test:vscode && npm run test:runtime && npm run test:history && npm run test:vscodechat && npm run test:folders && npm run test:events && npm run test:markdown && npm run test:rooms && npm run test:url && npm run test:mcp && npm run test:toolstats && npm run test:devhooks && npm run test:credits && npm run test:toolusage && npm run test:usagestore && npm run test:about && npm run test:usagetotals && npm run test:dialog && npm run test:modelswitch && npm run test:simmodel && npm run test:copilotmodel",
    "test:vscode": "tsc -p tsconfig.scripts.json && node dist-scripts/scripts/test-vscode.js",
    "test:history": "tsc -p tsconfig.scripts.json && node dist-scripts/scripts/test-history.js",
    "test:vscodechat": "tsc -p tsconfig.scripts.json && node dist-scripts/scripts/test-vscodechat.js",
    "test:folders": "tsc -p tsconfig.scripts.json && node dist-scripts/scripts/test-folders.js",
    "test:runtime": "tsc -p tsconfig.scripts.json && node dist-scripts/scripts/test-runtime.js",
    "prepare-runtime": "node scripts/prepare-runtime.js",
    "pack:dir": "npm run build && node scripts/prepare-runtime.js && electron-builder --dir --publish never",
    "dist:dir": "npm run pack:dir",
    "dist": "npm run build && node scripts/prepare-runtime.js && electron-builder --publish never",
    "dist:mac:arm64": "npm run build && node scripts/prepare-runtime.js darwin-arm64 && electron-builder --mac dmg zip --arm64 --publish never",
    "dist:mac:x64": "npm run build && node scripts/prepare-runtime.js darwin-x64 && electron-builder --mac dmg zip --x64 --publish never",
    "dist:win": "npm run build && node scripts/prepare-runtime.js win32-x64 && electron-builder --win nsis portable --x64 --publish never",
    "dist:linux": "npm run build && node scripts/prepare-runtime.js linux-x64 && electron-builder --linux AppImage --x64 --publish never",
    "test:events": "tsc -p tsconfig.scripts.json && node dist-scripts/scripts/test-events.js",
    "test:markdown": "tsc -p tsconfig.scripts.json && node dist-scripts/scripts/test-markdown.js",
    "test:rooms": "tsc -p tsconfig.scripts.json && node dist-scripts/scripts/test-rooms.js",
    "test:url": "tsc -p tsconfig.scripts.json && node dist-scripts/scripts/test-url.js",
    "test:mcp": "tsc -p tsconfig.scripts.json && node dist-scripts/scripts/test-mcp.js",
    "test:toolstats": "tsc -p tsconfig.scripts.json && node dist-scripts/scripts/test-toolstats.js",
    "test:credits": "tsc -p tsconfig.scripts.json && node dist-scripts/scripts/test-credits.js",
    "test:devhooks": "tsc -p tsconfig.scripts.json && node dist-scripts/scripts/test-devhooks.js",
    "check:office": "npm run build && node scripts/check-office-overlap.js",
    "test:usagestore": "tsc -p tsconfig.scripts.json && node dist-scripts/scripts/test-usagestore.js",
    "test:usagetotals": "tsc -p tsconfig.scripts.json && node dist-scripts/scripts/test-usagetotals.js",
    "test:toolusage": "tsc -p tsconfig.scripts.json && node dist-scripts/scripts/test-toolusage.js",
    "test:about": "tsc -p tsconfig.scripts.json && node dist-scripts/scripts/test-about.js",
    "test:modelswitch": "tsc -p tsconfig.scripts.json && node dist-scripts/scripts/test-modelswitch.js",
    "test:simmodel": "tsc -p tsconfig.scripts.json && node dist-scripts/scripts/test-sim-model.js",
    "test:copilotmodel": "tsc -p tsconfig.scripts.json && node dist-scripts/scripts/test-copilot-model.js",
    "test:dialog": "tsc -p tsconfig.scripts.json && node dist-scripts/scripts/test-dialog.js",
    "check:model": "npm run build && xvfb-run -a sh -c \"L=\\$(mktemp); DURBAR_USER_DATA=\\$(mktemp -d) DURBAR_SIM=15 DURBAR_SIM_FREEZE=1 DURBAR_DRIVER=\\$PWD/scripts/shots-model.js electron . --no-sandbox 2>&1 | tee \\$L; grep -q 'model] all checks passed' \\$L\"",
    "check:dialog-focus": "npm run build && xvfb-run -a sh -c \"L=\\$(mktemp); DURBAR_USER_DATA=\\$(mktemp -d) DURBAR_SIM=15 DURBAR_SIM_FREEZE=1 DURBAR_DRIVER=\\$PWD/scripts/check-dialog-focus.js electron . --no-sandbox 2>&1 | tee \\$L; grep -q 'dialog-focus] all checks passed' \\$L\""
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "jsdom": "25.0.1",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@github/copilot-sdk": "1.0.22",
    "dompurify": "3.4.17",
    "marked": "18.1.1"
  },
  "homepage": "https://github.com/three-feathers/agent-durbar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/three-feathers/agent-durbar.git"
  },
  "bugs": {
    "url": "https://github.com/three-feathers/agent-durbar/issues"
  },
  "keywords": [
    "electron",
    "copilot",
    "agents",
    "command-center"
  ],
  "build": {
    "appId": "io.github.three-feathers.agentdurbar",
    "productName": "Agent Durbar",
    "copyright": "Copyright (c) 2026 Three Feathers contributors",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/@github/copilot-sdk-*/**",
      "node_modules/koffi/**"
    ],
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "afterPack": "scripts/after-pack.js",
    "publish": null,
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "Agent-Durbar-${version}-${arch}.${ext}"
    },
    "dmg": {
      "sign": false
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Agent-Durbar-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Agent-Durbar-${version}-portable.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Development",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Agent-Durbar-${version}-${arch}.${ext}"
    }
  }
}
