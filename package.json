{
  "name": "agent-durbar",
  "version": "0.0.1",
  "description": "Command center to see, chat with and coordinate coding agents (Copilot CLI first) in an office-style view.",
  "private": true,
  "license": "MIT",
  "author": "Vikram Gorla",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "npm run build && electron .",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "electron": "^33.0.0",
    "typescript": "^5.6.0"
  }
}
