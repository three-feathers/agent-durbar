    "test:mcpsignin": "tsc -p tsconfig.scripts.json && node dist-scripts/scripts/test-mcp-signin.js",
    "test:dialog": "tsc -p tsconfig.scripts.json && node dist-scripts/scripts/test-dialog.js",
    "check:rename": "npm run build && xvfb-run -a sh -c \"L=\\$(mktemp); DURBAR_USER_DATA=\\$(mktemp -d) DURBAR_SIM=15 DURBAR_SIM_FREEZE=1 DURBAR_DRIVER=\\$PWD/scripts/check-rename.js electron . --no-sandbox 2>&1 | tee \\$L; grep -q 'rename] all checks passed' \\$L\"",
    "check:themes": "npm run build && node scripts/check-parallel.js --themes",
    "check:mac-titlebar": "npm run build && node scripts/check-mac-titlebar.js",
    "check:ui": "npm run build && node scripts/ui-suite.js",
    "shots:docs": "npm run build && node scripts/shots-docs.js",
    "shots:compress": "node scripts/compress-shots.js",
    "check:office:fast": "npm run build && node scripts/check-parallel.js",
    "check:geometry": "npm run build && node scripts/check-theme-geometry.js",
    "check:perf": "npm run build && node scripts/check-perf.js",
    "test:userthemes": "tsc -p tsconfig.scripts.json && node dist-scripts/scripts/test-userthemes.js",
    "test:pathdirs": "tsc -p tsconfig.scripts.json && node dist-scripts/scripts/test-pathdirs.js",
    "test:scenekits": "tsc -p tsconfig.scripts.json && node dist-scripts/scripts/test-scenekits.js",
    "test:mcpglobal": "tsc -p tsconfig.scripts.json && node dist-scripts/scripts/test-mcp-global.js",
    "test:mcpservertools": "tsc -p tsconfig.scripts.json && node dist-scripts/scripts/test-mcp-servertools.js",
    "test:slashcommands": "tsc -p tsconfig.scripts.json && node dist-scripts/scripts/test-slashcommands.js",
    "test:notes-core": "tsc -p tsconfig.scripts.json && node dist-scripts/scripts/test-notes.js && node dist-scripts/scripts/test-notesmask.js && node dist-scripts/scripts/test-notesipc.js && node dist-scripts/scripts/test-notessim.js && node dist-scripts/scripts/test-notesscreen.js",
    "test:notes-store": "tsc -p tsconfig.scripts.json && node dist-scripts/scripts/test-notesstore.js",
    "test:notesmd": "tsc -p tsconfig.scripts.json && node dist-scripts/scripts/test-notesmd.js",
    "test:notesfile": "tsc -p tsconfig.scripts.json && node dist-scripts/scripts/test-notesfile.js",
    "test:notes": "npm run test:notes-core && npm run test:notes-store && npm run test:notesmd && npm run test:notesfile"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "electron": "44.9.1",
    "electron-builder": "26.18.0",
    "jsdom": "25.0.1",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@github/copilot-sdk": "1.0.24",
    "dompurify": "3.4.17",
    "marked": "18.1.1"
  },
  "overrides": {
    "zod": "4.6.6"
  },
  "homepage": "https://github.com/three-feathers/agent-durbar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/three-feathers/agent-durbar.git"
  },
  "bugs": {
    "url": "https://github.com/three-feathers/agent-durbar/issues"
  },
  "keywords": [
    "electron",
    "copilot",
    "agents",
    "command-center"
  ],
  "build": {
    "appId": "io.github.three-feathers.agentdurbar",
    "productName": "Agent Durbar",
    "copyright": "Copyright (c) 2026 Three Feathers contributors",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/@github/copilot-sdk-*/**",
      "node_modules/koffi/**"
    ],
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "afterPack": "scripts/after-pack.js",
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true,
      "enableEmbeddedAsarIntegrityValidation": true
    },
    "publish": null,
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "signIgnore": [
        "/Contents/Resources/app\\.asar\\.unpacked/node_modules/@github/copilot-sdk-darwin-[a-z0-9]+/prebuilds/"
      ],
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "Agent-Durbar-${version}-${arch}.${ext}"
    },
    "dmg": {
      "sign": false
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Agent-Durbar-Setup-${version}.${ext}"
    },
    "appImage": {
      "executableArgs": []
    },
    "portable": {
      "artifactName": "Agent-Durbar-${version}-portable.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "syncDesktopName": true,
      "category": "Development",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Agent-Durbar-${version}-${arch}.${ext}"
    }
  }
}
