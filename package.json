  "devDependencies": {
    "@types/node": "^20.14.0",
    "electron": "44.9.1",
    "electron-builder": "26.18.0",
    "jsdom": "25.0.1",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@github/copilot-sdk": "1.0.24",
    "dompurify": "3.4.17",
    "marked": "18.1.2"
  },
  "overrides": {
    "zod": "4.6.6",
    "minimatch@^9.0.3": "11.0.5",
    "minimatch@^10.2.5": "11.0.5"
  },
  "homepage": "https://github.com/three-feathers/agent-durbar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/three-feathers/agent-durbar.git"
  },
  "bugs": {
    "url": "https://github.com/three-feathers/agent-durbar/issues"
  },
  "keywords": [
    "electron",
    "copilot",
    "agents",
    "command-center"
  ],
  "build": {
    "appId": "io.github.three-feathers.agentdurbar",
    "productName": "Agent Durbar",
    "copyright": "Copyright (c) 2026 Three Feathers contributors",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/@github/copilot-sdk-*/**",
      "node_modules/koffi/**"
    ],
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "afterPack": "scripts/after-pack.js",
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true,
      "enableEmbeddedAsarIntegrityValidation": true
    },
    "publish": null,
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "signIgnore": [
        "/Contents/Resources/app\\.asar\\.unpacked/node_modules/@github/copilot-sdk-darwin-[a-z0-9]+/prebuilds/"
      ],
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "Agent-Durbar-${version}-${arch}.${ext}"
    },
    "dmg": {
      "sign": false
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Agent-Durbar-Setup-${version}.${ext}"
    },
    "appImage": {
      "executableArgs": []
    },
    "portable": {
      "artifactName": "Agent-Durbar-${version}-portable.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "syncDesktopName": true,
      "category": "Development",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Agent-Durbar-${version}-${arch}.${ext}"
    }
  }
}
