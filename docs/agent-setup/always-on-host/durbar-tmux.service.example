[Unit]
Description=tmux session "durbar" with Claude Code
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'tmux has-session -t durbar 2>/dev/null || tmux new-session -d -s durbar -c %h/<workspace>/agent-durbar "bash -lc \"$HOME/bin/durbar-session; exec bash\""'
ExecStop=/usr/bin/tmux kill-session -t durbar

[Install]
WantedBy=default.target
