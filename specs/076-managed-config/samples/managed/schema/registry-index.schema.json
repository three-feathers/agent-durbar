{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://three-feathers.github.io/agent-durbar/schema/registry-index.v1.json",
  "title": "Agent Durbar agent, profile and skill registry index (v1)",
  "description": "An index of agent profiles, skills and prompt files that Durbar can install for the user. Every file carries its SHA-256; a file whose bytes do not match is refused. Durbar never runs a file from a registry.",
  "type": "object",
  "required": [
    "version",
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "publisher": {
      "allOf": [
        {
          "$ref": "#/$defs/text"
        }
      ],
      "maxLength": 120
    },
    "updated": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "items": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "app",
        "name",
        "version",
        "files"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "kind": {
          "enum": [
            "agent-profile",
            "skill",
            "prompt"
          ]
        },
        "app": {
          "enum": [
            "copilot",
            "claude",
            "codex"
          ]
        },
        "name": {
          "allOf": [
            {
              "$ref": "#/$defs/text"
            }
          ],
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "allOf": [
            {
              "$ref": "#/$defs/text"
            }
          ],
          "maxLength": 300
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([-+][0-9A-Za-z.-]+)?$"
        },
        "deprecated": {
          "type": "boolean"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "required": [
              "path",
              "url",
              "sha256",
              "bytes"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "maxLength": 200,
                "allOf": [
                  {
                    "pattern": "^(?!/)(?![A-Za-z]:)[A-Za-z0-9._/-]{1,200}$"
                  },
                  {
                    "not": {
                      "pattern": "(^|/)\\.\\.?(/|$)"
                    }
                  },
                  {
                    "not": {
                      "pattern": "//"
                    }
                  },
                  {
                    "not": {
                      "pattern": "[. ](/|$)"
                    }
                  },
                  {
                    "not": {
                      "pattern": "(^|/)([Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][0-9]|[Ll][Pp][Tt][0-9])(\\.[^/]*)?(/|$)"
                    }
                  }
                ],
                "description": "Relative path inside the item's install folder: no leading slash, drive letter, '.' or '..' segment, empty segment, backslash, trailing dot or space, or Windows reserved name."
              },
              "url": {
                "$ref": "#/$defs/httpsUrl",
                "description": "Must have the same origin (scheme, host, port) as the index (FR-061; checked by the validator)."
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 262144
              }
            }
          }
        }
      }
    },
    "httpsUrl": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^https://[A-Za-z0-9](?:[A-Za-z0-9.-]{0,251}[A-Za-z0-9])?(?::[0-9]{1,5})?(?:/[\\x21-\\x7e]*)?$",
      "description": "https only; host (letters, digits, dots, hyphens; IDN as punycode), optional port and path; no user:password@, no spaces, no control characters. Identical in all three schemas."
    },
    "text": {
      "type": "string",
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u200b-\\u200f\\u202a-\\u202e\\u2066-\\u2069\\ufeff<>]+$"
    }
  }
}
