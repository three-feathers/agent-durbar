{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://three-feathers.github.io/agent-durbar/schema/registry-index.v1.json",
  "title": "Agent Durbar agent, profile and skill registry index (v1)",
  "description": "An index of agent profiles, skills and prompt files that Durbar can install for the user. Every file carries its SHA-256; a file whose bytes do not match is refused. Durbar never runs a file from a registry.",
  "type": "object",
  "required": ["version", "items"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "publisher": { "type": "string", "maxLength": 120 },
    "updated": { "type": "string", "format": "date-time" },
    "items": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/item" } }
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": ["id", "kind", "app", "name", "version", "files"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" },
        "kind": { "enum": ["agent-profile", "skill", "prompt"] },
        "app": { "enum": ["copilot", "claude", "codex"] },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": "string", "maxLength": 300 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([-+][0-9A-Za-z.-]+)?$" },
        "deprecated": { "type": "boolean" },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "required": ["path", "url", "sha256", "bytes"],
            "additionalProperties": false,
            "properties": {
              "path": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.)(?!.*\\\\)[A-Za-z0-9._/-]{1,200}$", "description": "Relative path inside the item's install folder; no '..', no backslash, no leading slash." },
              "url": { "type": "string", "pattern": "^https://", "maxLength": 2048 },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "bytes": { "type": "integer", "minimum": 1, "maximum": 262144 }
            }
          }
        }
      }
    }
  }
}
